# .env.staging.example — Staging Environment Template
# Copy this file to .env.staging and populate with your staging project credentials.
# .env.staging is automatically ignored by Git (.env* rule in .gitignore).

# ─── Supabase Staging Project (Public — Safe for browser) ──────────────────────
# Obtain from: Supabase Dashboard -> edvora-staging -> Project Settings -> API
# Note: The project reference must NOT match the development project (sauphnaxchcouqslflsl)
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-staging-anon-key>

# ─── Supabase Staging Project (Server-Only — Private Service Role) ─────────────
# NEVER prefix with NEXT_PUBLIC_. Bypasses RLS for trusted backend operations.
SUPABASE_SERVICE_ROLE_KEY=<your-staging-service-role-key>

# ─── Staging Corporate Banking Configuration (SEC-3B2C2-LOW-02) ───────────────
# Staging test coordinates for manual subscription verification testing
BANK_NAME=Commercial Bank of Ceylon (Staging)
BANK_BRANCH=Colombo Fort
BANK_ACCOUNT_NAME=Edvora Technologies (Pvt) Ltd (Staging)
BANK_ACCOUNT_NUMBER=1000998877
BANK_PAYMENT_INSTRUCTIONS=Staging test deposit: please enter transaction reference or upload receipt slip below.
